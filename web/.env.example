# Supabase project settings. These are public browser-side values; never put a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# GouYingAi gateway base URL. When set, users get the fixed model catalog from the
# gateway and every AI request is proxied through it with the server-side API key.
VITE_GATEWAY_URL=http://127.0.0.1:8788
